# 개발 환경 설정
# 모바일 핫스팟 사용 시 PC의 실제 IP 주소로 변경하세요

# localhost (기본값) - 로컬 개발용
VUE_APP_API_BASE_URL=http://localhost:8084/api

# 현재 네트워크 IP (10.2.120.63) - 같은 네트워크의 다른 기기에서 접속 가능
# VUE_APP_API_BASE_URL=http://10.2.120.63:8084/api

# 모바일 핫스팟 사용 시 (핫스팟 켜진 경우에만)
